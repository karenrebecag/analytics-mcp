{
  "name": "analytics-mcp",
  "version": "0.1.0",
  "description": "Unified web-analytics MCP server \u2014 GA4, Cloudflare Web Analytics, Vercel Analytics and Google Search Console behind one normalized tool surface. StreamableHTTP for remote clients (Claude web), stdio for local ones.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "license": "MIT",
  "bin": {
    "analytics-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "probe": "tsx scripts/probe.ts",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src/ api/ tests/",
    "format": "prettier --write 'src/**/*.ts' 'api/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'api/**/*.ts' 'tests/**/*.ts'",
    "test": "vitest run",
    "gates": "pnpm build && vitest run --config vitest.gates.config.ts",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm test && pnpm gates",
    "serve": "node dist/serve.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "optionalDependencies": {
    "@clerk/backend": "^3.4.0"
  }
}
